<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Reachable from `adb shell am broadcast -n app.pegelstand/.debug.DebugReceiver`:
     exported, but the DUMP permission is held by the adb shell and cannot be obtained by apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
