<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widgets: bottle on the left at full height, amount and streak chip to its right, undo in
     the top-right corner. Sizes are set per widget size from WidgetLayout on Android 12+; the
     weights are the fallback before that. Tap zones: only the bottle's box (widget_frames) adds an
     intake; the root, out to the widget edges, opens the app; undo undoes. The root has no
     padding; widget_content carries it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_bottle_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="0.6">

                <ImageView
                    android:id="@+id/widget_bottle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_bottle"
                    android:scaleType="fitCenter" />

                <!-- The add-intake zone, always visible. Holds the level animation's flipper while a
                     change plays, else the idle wave's. -->
                <FrameLayout
                    android:id="@+id/widget_frames"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/widget_text_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip"
                    android:maxLines="1"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/widget_on_chip"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_undo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/widget_undo_description">

            <ImageView
                android:id="@+id/widget_undo_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_undo"
                android:tint="@color/widget_on_surface" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
